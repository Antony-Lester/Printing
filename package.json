{
  "name": "Printing",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:debug": "react-native run-android --variant=debug",
    "android:release": "react-native run-android --variant=release",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "adb:install:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "adb:install:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "adb:install:debug:launch": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb shell am start -n com.printing/.MainActivity",
    "adb:install:release:launch": "adb install -r android/app/build/outputs/apk/release/app-release.apk && adb shell am start -n com.printing/.MainActivity",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "log": "npx react-native log-android"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.87.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-tcp-socket": "^6.0.0",
    "react-native-thermal-pos-printer": "^1.6.6",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
